            # 5. ADVANCED GITHUB API (Push Multiple Files)\
            # ==========================================\
            elif task.tool_name == "push_files_to_github":\
                logger.info("   -> Routing to REAL GitHub API: Committing Directory...")\
                gh_token = os.getenv("GITHUB_TOKEN")\
                gh_owner = os.getenv("GITHUB_OWNER")\
                gh_repo = os.getenv("GITHUB_REPO")\
                branch_name = resolved_args.get("branch_name")\
                directory_path = resolved_args.get("directory_path", "workspace")\
                commit_message = resolved_args.get("commit_message", "Automated upload from Agentic Gateway")\
\
                headers = \{"Authorization": f"token \{gh_token\}", "Accept": "application/vnd.github.v3+json"\}\
                \
                async with httpx.AsyncClient() as client:\
                    # 1. Get current branch SHA\
                    ref_resp = await client.get(f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/refs/heads/\{branch_name\}", headers=headers)\
                    commit_sha = ref_resp.json()["object"]["sha"]\
\
                    # 2. Get base tree SHA\
                    commit_resp = await client.get(f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/commits/\{commit_sha\}", headers=headers)\
                    base_tree_sha = commit_resp.json()["tree"]["sha"]\
\
                    # 3. Create Blobs for every file in the directory\
                    tree_items = []\
                    for root_dir, _, files in os.walk(directory_path):\
                        for file in files:\
                            file_path = os.path.join(root_dir, file)\
                            \
                            # Read file and encode it (safely handles code, text, and images)\
                            with open(file_path, "rb") as f:\
                                content = base64.b64encode(f.read()).decode("utf-8")\
                                \
                            blob_resp = await client.post(\
                                f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/blobs",\
                                headers=headers, json=\{"content": content, "encoding": "base64"\}\
                            )\
                            blob_sha = blob_resp.json()["sha"]\
                            \
                            # Calculate the clean path for GitHub\
                            git_path = os.path.relpath(file_path, directory_path).replace("\\\\", "/")\
                            tree_items.append(\{"path": git_path, "mode": "100644", "type": "blob", "sha": blob_sha\})\
\
                    # 4. Create new Tree\
                    tree_resp = await client.post(\
                        f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/trees",\
                        headers=headers, json=\{"base_tree": base_tree_sha, "tree": tree_items\}\
                    )\
                    new_tree_sha = tree_resp.json()["sha"]\
\
                    # 5. Create new Commit\
                    new_commit_resp = await client.post(\
                        f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/commits",\
                        headers=headers, json=\{"message": commit_message, "tree": new_tree_sha, "parents": [commit_sha]\}\
                    )\
                    new_commit_sha = new_commit_resp.json()["sha"]\
\
                    # 6. Push Commit to Branch\
                    await client.patch(\
                        f"https://api.github.com/repos/\{gh_owner\}/\{gh_repo\}/git/refs/heads/\{branch_name\}",\
                        headers=headers, json=\{"sha": new_commit_sha\}\
                    )\
\
                    mock_output = \{"status": "success", "message": f"Successfully pushed \{len(tree_items)\} files to GitHub."\}}